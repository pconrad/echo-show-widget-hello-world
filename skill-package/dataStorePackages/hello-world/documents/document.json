{
  "type": "APL",
  "version": "2023.1",
  "license": "Copyright 2023 Amazon.com, Inc. or its affiliates. All Rights Reserved.\nSPDX-License-Identifier: LicenseRef-.amazon.com.-AmznSL-1.0\nLicensed under the Amazon Software License  http://aws.amazon.com/asl/",
  "theme": "dark",
  "mainTemplate": {
    "parameters": ["helloData"],
    "items": [
      {
        "type": "TouchWrapper",
        "width": "100vw",
        "height": "100vh",
        "accessibilityLabel": "Hello world. Open the hello widget skill.",
        "onPress": {
          "type": "SendEvent",
          "arguments": ["hello"],
          "flags": { "interactionMode": "STANDARD" }
        },
        "item": {
          "type": "Container",
          "width": "100%",
          "height": "100%",
          "paddingLeft": "6vw",
          "paddingRight": "6vw",
          "justifyContent": "center",
          "alignItems": "center",
          "items": [
            {
              "type": "Text",
              "text": "${helloData.title}",
              "fontSize": "12vh",
              "fontWeight": "bold",
              "color": "#FFFFFF",
              "textAlign": "center",
              "maxLines": 2
            },
            {
              "type": "Text",
              "text": "${helloData.subtitle}",
              "fontSize": "6vh",
              "color": "#FFFFFF",
              "textAlign": "center",
              "maxLines": 2,
              "spacing": "3vh"
            },
            {
              "type": "Text",
              "text": "${helloData.hint}",
              "fontSize": "5vh",
              "color": "#CCCCCC",
              "textAlign": "center",
              "maxLines": 2,
              "spacing": "5vh"
            }
          ]
        }
      }
    ]
  }
}
